# Нусха гиред: cp .env.example .env  — ва қиматҳои воқеиро гузоред.
# .env ҲЕҶ ГОҲ ба GitHub намеравад.

# PostgreSQL — танҳо ҳамин ду сатр провайдерро муайян мекунанд.
# Neon: DATABASE_URL = пайвасти «pooled», DIRECT_URL = пайвасти мустақим.
# VPS / Supabase / сервери мактаб: ҳардуяш як хел.
DATABASE_URL="postgresql://user:password@host:5432/maorif?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/maorif?sslmode=require"

# Мактаб (seed онро як бор месозад)
SCHOOL_NAME="МТМУ №12"
SCHOOL_DISTRICT="Зафаробод"

# Ҳисоби аввал — мудир (тугмаи «Мутахассис»). Дар воридшавии аввал парол иваз мешавад.
SEED_DIRECTOR_LOGIN="mudir"
SEED_DIRECTOR_NAME="Мудири мактаб"
SEED_DIRECTOR_PASSWORD="ivaz-kuned-ba-paroli-qavi"
# 1 = мутахассиси аввал ҳам сохта шавад (паролаш дар экран чоп мешавад)
SEED_SPECIALIST="0"

# Ихтиёрӣ: нигоҳдории файлҳои «сабабнок» (Supabase Storage, bucket-и private)
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_BUCKET="excuses"
